{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_SERVER};Database=${DB_NAME};Trusted_Connection=${DB_TRUSTED_CONNECTION};MultipleActiveResultSets=${DB_MULTIPLE_ACTIVE_RESULTSETS}"
  },
  "Ldap": {
    "Server": "${LDAP_SERVER}",
    "Port": "${LDAP_PORT}",
    "Domain": "${LDAP_DOMAIN}",
    "SearchBase": "${LDAP_SEARCH_BASE}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpireMinutes": "${JWT_EXPIRE_MINUTES}"
  },
  "EmailSettings": {
    "SmtpServer": "${SMTP_SERVER}",
    "Port": "${SMTP_PORT}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${FROM_EMAIL}",
    "EnableSsl": "${ENABLE_SSL}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}